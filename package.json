{
  "name": "jeff",
  "private": true,
  "version": "0.8.10",
  "workspaces": [
    "web",
    "landing/preview",
    "desktop",
    "mobile",
    "packages/brand",
    "packages/ui",
    "packages/icons"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @jeff/web",
    "dev:landing": "npm run dev --workspace @jeff/landing",
    "build:web": "npm run build --workspace @jeff/web",
    "build:landing": "npm run build --workspace @jeff/landing",
    "build:client": "npm run build:desktop",
    "build:desktop": "npm run build --workspace @jeff/desktop",
    "build:mobile": "npm run build --workspace @jeff/mobile",
    "test": "npm run test --workspace @jeff/web",
    "build:server": "cargo build --release --manifest-path backend/Cargo.toml --bin jeff",
    "test:server": "cargo test --manifest-path backend/Cargo.toml"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "dependencies": {}
}
