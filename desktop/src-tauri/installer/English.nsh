LangString MUI_TEXT_WELCOME_INFO_TITLE ${LANG_ENGLISH} "Welcome to Jeff"
LangString MUI_TEXT_WELCOME_INFO_TEXT ${LANG_ENGLISH} "This wizard installs Jeff on this computer. Afterwards you choose between connecting to a Jeff server or opening a local workspace.$\r$\n$\r$\nClick Next to continue."
