JEFF_ADDR=127.0.0.1:8787
JEFF_DATA_DIR=./data
JEFF_DATABASE_URL=postgres://jeff:jeff@127.0.0.1:5432/jeff
# install.sh provisions a local Redis; override to point elsewhere.
JEFF_REDIS_URL=redis://127.0.0.1:6379
JEFF_WORKSPACES=/workspaces
JEFF_ADMIN_PASSWORD=
# Set true behind HTTPS; the installer enables it.
JEFF_SECURE_COOKIES=false
JEFF_TRUSTED_PROXIES=
JEFF_WEB_DIR=
JEFF_BUILD_ID=
