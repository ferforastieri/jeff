# Copy to deploy/.env and adjust to the host.
# Host path mounted at /workspaces inside the container.
JEFF_WORKSPACES_HOST=/srv/workspaces
# Host user and group that own the workspace (id -u / id -g on the host).
# The container starts as root only long enough to align /data and /home/jeff,
# then drops to this user. Use the same values as the workspace owner so the
# Drive and the agents can create and delete files, including 0700 folders.
JEFF_UID=1000
JEFF_GID=1000
# Set only when the workspace group differs from JEFF_GID.
# JEFF_WORKSPACE_GID=1000
