{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jeff",
  "version": "0.99.9",
  "identifier": "br.com.ferforastieri.jeff",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Jeff", "dragDropEnabled": false, "theme": "Dark", "backgroundColor": "#000000" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
